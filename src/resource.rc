#pragma code_page(65001)

#include "resource.h"

IDI_APP ICON "app.ico"

/* RT_MANIFEST = 24；1 表示 CREATEPROCESS_MANIFEST_RESOURCE_ID */
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,0,1,0
 PRODUCTVERSION 2,0,1,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      ""
            VALUE "FileDescription",  "Screenshot Translator"
            VALUE "FileVersion",      "2.0.1"
            VALUE "InternalName",     "screenshot-translator"
            VALUE "OriginalFilename", "screenshot-translator.exe"
            VALUE "ProductName",      "截图翻译"
            VALUE "ProductVersion",   "2.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
